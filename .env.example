# 数据库配置
SMILEYAN_BACKEND_DB_HOST=localhost
SMILEYAN_BACKEND_DB_USER=root
SMILEYAN_BACKEND_DB_PASSWORD=
SMILEYAN_BACKEND_DB_NAME=smileyan

# Redis 配置
SMILEYAN_BACKEND_REDIS_HOST=localhost
SMILEYAN_BACKEND_REDIS_USERNAME=
SMILEYAN_BACKEND_REDIS_PASSWORD=

# 邮箱配置
SMILEYAN_BACKEND_EMAIL_PASSWORD=

# JWT 配置
SMILEYAN_BACKEND_JWT_SECRET=

# 本地开发用 dev token（可选；仅当 JWT 的 dev claim 与此值一致时生效，生产不要设置）
SMILEYAN_BACKEND_DEV_TOKEN=

# TTS 配置（可选，启用 /v1/audio/speech 时填写）
SMILEYAN_BACKEND_TTS_BASE_URL=
SMILEYAN_BACKEND_TTS_API_KEY=
SMILEYAN_BACKEND_TTS_DEFAULT_MODEL=
