{
  "name": "upload_avatar_jpeg_ext",
  "request": {
    "method": "POST",
    "path": "/api/upload-avatar",
    "headers": {
      "Authorization": "Bearer <reader>",
      "Content-Type": "multipart/form-data; boundary=----smileyan-capture-boundary",
      "X-Forwarded-For": "203.0.113.10"
    },
    "multipart": {
      "field": "avatar",
      "filename": "capture-avatar.jpeg",
      "bytes": 70
    }
  },
  "response": {
    "status": 400,
    "headers": {
      "connection": "close",
      "content-type": "application/json; charset=utf-8"
    },
    "json": {
      "error": "Invalid file type. Only JPG, PNG, GIF allowed"
    }
  }
}
