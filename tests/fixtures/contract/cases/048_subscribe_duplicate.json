{
  "name": "subscribe_duplicate",
  "request": {
    "method": "POST",
    "path": "/api/subscribe",
    "headers": {
      "Content-Type": "application/json",
      "X-Forwarded-For": "203.0.113.10"
    },
    "json": {
      "email": "newsub@example.com"
    }
  },
  "response": {
    "status": 400,
    "headers": {
      "connection": "close",
      "content-type": "application/json; charset=utf-8"
    },
    "json": {
      "error": "Already subscribed"
    }
  }
}
