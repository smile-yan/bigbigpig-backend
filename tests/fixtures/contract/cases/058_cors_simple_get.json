{
  "name": "cors_simple_get",
  "request": {
    "method": "GET",
    "path": "/api/hello",
    "headers": {
      "X-Forwarded-For": "203.0.113.10"
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "access-control-allow-origin": "*",
      "access-control-expose-headers": "Content-Length",
      "connection": "close",
      "content-type": "application/json; charset=utf-8"
    },
    "json": {
      "message": "Hello, World!"
    }
  }
}
