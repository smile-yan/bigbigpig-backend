# Copy to .env.capture and adjust if the defaults collide with local services.
#
# The capture scripts source .env.capture (if present) before starting the
# disposable Docker stack.

# Path to the frozen Go baseline checkout.
BACKEND_DIR=../smileyan-backend

# Host ports exposed by tests/fixtures/docker-compose.yml.
CAPTURE_MYSQL_PORT=13306
CAPTURE_REDIS_PORT=16379
CAPTURE_SMTP_PORT=11025
CAPTURE_MAILHOG_HTTP_PORT=18025

# Host ports for the Go server and the TTS mock.
CAPTURE_APP_PORT=18080
CAPTURE_TTS_MOCK_PORT=19099

# Passwords/secrets used only by the disposable capture stack.
CAPTURE_MYSQL_PASSWORD=capturepass
CAPTURE_REDIS_PASSWORD=capturepass
CAPTURE_JWT_SECRET=capture-jwt-secret
CAPTURE_DEV_TOKEN=capture-dev-token
CAPTURE_TTS_API_KEY=capture-tts-key
