#!/bin/bash
# Local development start: prefers target/debug/smileyan-backend, builds it
# when missing, then starts it with nohup and logs/app.pid (same layout as the
# production start.sh generated by scripts/deploy-remote.sh).

set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
cd "$PROJECT_DIR" || exit 1

if [ -f .env ]; then
  set -a
  # shellcheck disable=SC1091
  . ./.env
  set +a
fi

PORT="$(awk '
  /^server:[[:space:]]*$/ { s = 1; next }
  s && /^[[:space:]]+port:/ { print $2; exit }
  s && /^[^[:space:]#]/ { exit }
' config.yaml 2>/dev/null)"
PORT="${PORT:-8080}"

if [ -f logs/app.pid ]; then
  PID="$(cat logs/app.pid 2>/dev/null || true)"
  if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
    echo "smileyan-backend is already running (pid $PID, port $PORT)"
    exit 0
  fi
  rm -f logs/app.pid
fi

# Dev-only convenience: free the port if another listener owns it.
if command -v lsof >/dev/null 2>&1; then
  PIDS="$(lsof -t -iTCP:"$PORT" -sTCP:LISTEN 2>/dev/null || true)"
  if [ -n "$PIDS" ]; then
    echo "Port $PORT is busy; stopping pid(s): $PIDS"
    # shellcheck disable=SC2086
    kill $PIDS 2>/dev/null || true
    sleep 1
  fi
fi

BIN="target/debug/smileyan-backend"
if [ ! -x "$BIN" ]; then
  echo "Building $BIN ..."
  cargo build || exit 1
fi

mkdir -p logs uploads/avatars

echo "Starting Smileyan Backend on port $PORT ..."
nohup "./$BIN" > logs/app.log 2>&1 &
echo $! > logs/app.pid
echo "Started, PID: $(cat logs/app.pid)"
echo "Logs: $PROJECT_DIR/logs/app.log"
